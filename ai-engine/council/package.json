{
  "name": "ahs-council-engine",
  "version": "1.1.0",
  "private": true,
  "description": "教材上傳引擎（原 AI-Study-Council）：OCR、三方 AI 交叉審議、Final.md → 學習平台教材包",
  "main": "server.js",
  "scripts": {
