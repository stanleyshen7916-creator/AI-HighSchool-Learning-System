    "tesseract.js": "6.0.1",
    "undici": "^6.28.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setupDataDir.js"
