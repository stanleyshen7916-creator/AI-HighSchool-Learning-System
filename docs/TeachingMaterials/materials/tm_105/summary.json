  "keyPoints": [
    "先通讀整篇短文，掌握主題與前後句意，再回頭填空",
    "同一字根的衍生字要看空格的詞性（名詞、形容詞、副詞、動詞）判斷字尾"
  ],
  "pitfalls": [
    "只看單一句子就選答案，沒有讀前後文",
    "衍生字詞性選錯（-tion／-sion、-ful、-ly 的用法）；片語的介系詞選錯"
  ],
  "reviewSuggestions": [
    "答錯的字到知識弱點重做，直到連續答對",
    "把衍生字整組寫一次：動詞 → 名詞 → 形容詞"
  ]
